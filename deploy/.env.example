# Settings for one environment of the DNH API on the VPS.
#
# Copy to /opt/dnh-server/.env.staging or /opt/dnh-server/.env.production,
# owned by root, mode 600. deploy.sh refuses a file with any other mode.
#
# Format: KEY=value, one per line, no "export " prefix (unlike .envrc).
# Quote a value only if it has spaces or a #. Values marked [secret] are
# generated or issued separately for staging and production; never reuse one
# across environments or paste one into chat, a ticket or a commit.
#
# PORT and QUEUE_TLS are set by compose.yml and ignored here.

# --- Application ---------------------------------------------------------

# staging or production; must match the file name. Production also turns off
# the Swagger docs; staging rejects unknown request fields with a 400.
NODE_ENV=staging

# --- Database (MongoDB, hosted outside this VPS) ---------------------------

# [secret] The database server, e.g. on another VPS or MongoDB Atlas. Use TLS
# when it crosses the internet, and allow only this VPS's IP on its firewall.
# Percent-encode special characters in the password.
DB_CONNECTION_STRING=mongodb://dnh_staging:CHANGE_ME@db.example.com:27017/?authSource=admin&tls=true
# Staging and production need different database names, even on different
# servers: deploy.sh refuses two files with the same DB_NAME.
DB_NAME=dnh_staging

# --- Redis (runs next to the API, see compose.yml) --------------------------

# Exactly redis://dnh-redis-<environment>:6379; deploy.sh checks it. That
# Redis is reachable only from its own environment's API, so it has no
# password.
REDIS_URL=redis://dnh-redis-staging:6379

# --- Authentication --------------------------------------------------------

# [secret] openssl rand -hex 32
JWT_SECRET=
JWT_TTL=
OTP_TTL=
# Required: staff login fails without it. A different value per environment,
# so one environment's staff tokens are refused by the other.
JWT_TOKEN_ISSUER=dnh-server-staging
NANOID_GEN=
# OAuth client ID the mobile app's Google sign-in tokens are issued for.
GOOGLE_CLIENT_ID=

# --- Firebase (service account of this environment's project) --------------

FIREBASE_BASE_PROJECT_ID=
FIREBASE_BASE_PRIVATE_KEY_ID=
# [secret] Keep it on one line with \n escapes, in double quotes.
FIREBASE_BASE_PRIVATE_KEY=
FIREBASE_BASE_CLIENT_EMAIL=
FIREBASE_BASE_CLIENT_ID=
FIREBASE_BASE_CLIENT_CERT_URL=
BASE_STORAGE_BUCKET=

# --- Email (SMTP) ----------------------------------------------------------

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
# [secret]
EMAIL_PASSWORD=
EMAIL_FROM=

# --- SMS and USSD (Africa's Talking) ----------------------------------------

ATSK_USERNAME=
# [secret]
ATSK_API_KEY=
ATSK_SENDER=
ATSK_SHORT_CODE=
# [secret] openssl rand -hex 32. Register the USSD callback as
# https://<api host>/api/v1/ussd?key=<this value>
USSD_CALLBACK_SECRET=
# Optional: comma-separated source IPs allowed to call POST /ussd.
USSD_ALLOWED_IPS=

# --- Network ---------------------------------------------------------------

# Comma-separated browser origins allowed by CORS (the HCP web app).
CORS_ORIGINS=
# Proxy hops in front of the API: 1 for a reverse proxy on this VPS (nginx,
# Caddy, Cloudflare Tunnel). A higher value lets clients spoof their IP and
# get around the per-IP rate limits.
TRUST_PROXY=1

# --- Logging (BetterStack) -------------------------------------------------

# Required: outside development the API refuses to start without them.
# Errors and warnings are sent here as well as to the container's log.
# The source's ingesting host from BetterStack, with https://.
LOGTAIL_HOST=https://CHANGE_ME.betterstackdata.com
# [secret]
LOGTAIL_SOURCE_TOKEN=

# --- Optional --------------------------------------------------------------

# true|false; unset means on for staging only.
FORBID_UNKNOWN_FIELDS=
# Days audit log entries are kept; unset uses the app default.
AUDIT_LOG_TTL_DAYS=

# The AI features (Gemini, Whisper, Qdrant) are retired: leave GOOGLE_API_KEY,
# GOOGLE_GENERATIVE_AI_API_KEY, GOOGLE_AI_VERSION, OPENAI_API_KEY, QDRANT_URL,
# QDRANT_API_KEY and QDRANT_HOST out. The API boots and works without them.
