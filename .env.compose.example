# Settings for docker-compose.yml. Copy to `.env` (next to docker-compose.yml);
# compose reads it automatically. App settings go in .env.production instead.
#
# Use URL-safe passwords: they are placed in connection URLs unescaped.
# Generate them with: openssl rand -hex 32

MONGO_ROOT_USERNAME=dnh
MONGO_ROOT_PASSWORD=
REDIS_PASSWORD=

# Number of reverse proxies in front of the API, e.g. 1 for nginx/Caddy on
# this host, 2 for a load balancer in front of that proxy, 0 if clients
# connect directly. It must match reality, or clients can spoof their IP
# through X-Forwarded-For and bypass USSD_ALLOWED_IPS and rate limits.
TRUST_PROXY=1

# Host address the API port is published on. Keep 127.0.0.1 when the reverse
# proxy runs on this host; use a private interface address otherwise.
API_BIND_ADDRESS=127.0.0.1
